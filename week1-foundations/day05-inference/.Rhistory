# ---- SIMULATION FUNCTION ----
sim_one <- function() {
# -- Design --
cohort <- rep(1:n_cohorts, times = n_per_coh)
N_i    <- length(cohort)
entry  <- entry_ages[cohort]
id     <- 1:N_i
dat <- data.frame(
id    = rep(id, each = n_visits),
visit = rep(1:n_visits, times = N_i),
age   = rep(entry, each = n_visits) + rep(0:(n_visits - 1), times = N_i) +
rnorm(N_i * n_visits, 0, age_sd)
)
# -- Attrition --
if (attrition > 0) {
last_visit <- rep(n_visits, N_i)
for (v in 2:n_visits) {
drops <- which(last_visit >= v & runif(N_i) < d_per_visit)
last_visit[drops] <- v - 1
}
dat <- dat[dat$visit <= last_visit[dat$id], ]
}
dat$age_c <- dat$age - knot
# -- Generate exposure X (mean 0, variance 1, within-person ICC) --
tau2  <- ICC_X
sig2x <- 1 - tau2
bx    <- rnorm(N_i, 0, sqrt(tau2))       # random intercept for X
dat$X <- bx[dat$id] + rnorm(nrow(dat), 0, sqrt(sig2x))
# -- Lagged predictor (Aim 3) --
if (use_lag) {
dat <- dat[order(dat$id, dat$visit), ]
dat$X_lag <- ave(dat$X, dat$id, FUN = function(x) c(NA, head(x, -1)))
dat <- dat[!is.na(dat$X_lag), ]
dat$X <- dat$X_lag
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
dat$visit_eff <- ave(dat$visit, dat$id, FUN = seq_along)
# -- Fit model --
fit <- tryCatch(
gls(Y ~ age_c + X, data = dat,
correlation = corSymm(form = ~ visit_eff | id),
weights = varIdent(form = ~ 1 | visit_eff)),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$tTable
p_gamma <- coefs["X", "p-value"]
}else{
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
# -- Fit model --
fit <- tryCatch(
lmer(Y ~ age_c + X + (age_c | id), data = dat,
control = lmerControl(optimizer = "bobyqa",
check.conv.singular = "ignore",
optCtrl = list(maxfun = 1e5))),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$coefficients
p_gamma <- coefs["X", "Pr(>|t|)"]
}
c(p_gamma = p_gamma, converged = !isSingular(fit))
}
sim_one()
?gls
str(fit)
fit$apVar
str(fit$apVar)
eigen(fit$apVar)
eigen(fit$apVar)$values
# ---- SIMULATION FUNCTION ----
sim_one <- function() {
# -- Design --
cohort <- rep(1:n_cohorts, times = n_per_coh)
N_i    <- length(cohort)
entry  <- entry_ages[cohort]
id     <- 1:N_i
dat <- data.frame(
id    = rep(id, each = n_visits),
visit = rep(1:n_visits, times = N_i),
age   = rep(entry, each = n_visits) + rep(0:(n_visits - 1), times = N_i) +
rnorm(N_i * n_visits, 0, age_sd)
)
# -- Attrition --
if (attrition > 0) {
last_visit <- rep(n_visits, N_i)
for (v in 2:n_visits) {
drops <- which(last_visit >= v & runif(N_i) < d_per_visit)
last_visit[drops] <- v - 1
}
dat <- dat[dat$visit <= last_visit[dat$id], ]
}
dat$age_c <- dat$age - knot
# -- Generate exposure X (mean 0, variance 1, within-person ICC) --
tau2  <- ICC_X
sig2x <- 1 - tau2
bx    <- rnorm(N_i, 0, sqrt(tau2))       # random intercept for X
dat$X <- bx[dat$id] + rnorm(nrow(dat), 0, sqrt(sig2x))
# -- Lagged predictor (Aim 3) --
if (use_lag) {
dat <- dat[order(dat$id, dat$visit), ]
dat$X_lag <- ave(dat$X, dat$id, FUN = function(x) c(NA, head(x, -1)))
dat <- dat[!is.na(dat$X_lag), ]
dat$X <- dat$X_lag
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
dat$visit_eff <- ave(dat$visit, dat$id, FUN = seq_along)
# -- Fit model --
fit <- tryCatch(
gls(Y ~ age_c + X, data = dat,
correlation = corSymm(form = ~ visit_eff | id),
weights = varIdent(form = ~ 1 | visit_eff)),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$tTable
p_gamma <- coefs["X", "p-value"]
convg <- I(all(eigen(fit$apVar)$values>0))
}else{
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
# -- Fit model --
fit <- tryCatch(
lmer(Y ~ age_c + X + (age_c | id), data = dat,
control = lmerControl(optimizer = "bobyqa",
check.conv.singular = "ignore",
optCtrl = list(maxfun = 1e5))),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$coefficients
p_gamma <- coefs["X", "Pr(>|t|)"]
convg <- !isSingular(fit)
}
c(p_gamma = p_gamma, converged = convg)
}
sim_one()
sim_one()
sim_one()
## ------------------------------------------------------------------
## Power simulation: Aims 2 and 3
## Continuous time-varying predictor in a linear mixed model
## Accelerated longitudinal design
## ------------------------------------------------------------------
## Requires: lme4, MASS
## install.packages(c("lme4", "MASS"))
library(lmerTest)
library(lme4)
library(nlme)
library(MASS)
# ---- OUTCOME PARAMETERS (same structure as Aim 1) ----
beta_0    <- 25.3991    # mean outcome at age 5
beta_1    <-  0.8711    # age slope (per year)
sigma2_b0 <- 36.5603    # random intercept variance
sigma2_b1 <-  0.9696    # random slope variance
cov_b0b1  <-  3.96      # intercept-slope covariance
sigma2_e  <-  8.1681    # residual variance
# Marginal SD of outcome at age 5 (for standardizing effect size)
SD_Y <- sqrt(sigma2_b0 + sigma2_e)
# ---- EXPOSURE PARAMETERS ----
# Exposure X is generated with mean 0, variance 1, and within-person ICC
ICC_X <- 0.50           # within-person correlation of exposure over time
es_vec <- seq(0.1,0.2,0.05)
use_lag_vec <- c(TRUE, FALSE)
res <- NULL
for(effect_size in es_vec){
for(use_lag in use_lag_vec){
# ---- STANDARDIZED EFFECT SIZE ----
# effect_size = gamma / SD_Y, so gamma = effect_size * SD_Y
# A 1-SD increase in X is associated with effect_size SDs change in Y
# effect_size <- 0.20     # <-- SET THIS (e.g., 0.10, 0.15, 0.20, 0.30)
gamma_2     <- effect_size * SD_Y
# ---- DESIGN PARAMETERS ----
N          <- 150
n_cohorts  <- 6
n_per_coh  <- rep(N / n_cohorts, n_cohorts)
n_visits   <- 3
entry_ages <- 3:8
knot       <- 5
n_sims     <- 1000
alpha      <- 0.05
attrition  <- 0.10
age_sd     <- 0.2
d_per_visit <- 1 - (1 - attrition)^(1 / (n_visits - 1))
# ---- LAGGED PREDICTOR FLAG ----
# FALSE = concurrent predictor (Aim 2); TRUE = lagged predictor (Aim 3)
# use_lag <- FALSE        # <-- SET THIS
set.seed(2026)
# ---- RANDOM EFFECTS COVARIANCE (outcome) ----
Sigma_re <- matrix(c(sigma2_b0, cov_b0b1,
cov_b0b1,  sigma2_b1), nrow = 2)
# ---- SIMULATION FUNCTION ----
sim_one <- function() {
# -- Design --
cohort <- rep(1:n_cohorts, times = n_per_coh)
N_i    <- length(cohort)
entry  <- entry_ages[cohort]
id     <- 1:N_i
dat <- data.frame(
id    = rep(id, each = n_visits),
visit = rep(1:n_visits, times = N_i),
age   = rep(entry, each = n_visits) + rep(0:(n_visits - 1), times = N_i) +
rnorm(N_i * n_visits, 0, age_sd)
)
# -- Attrition --
if (attrition > 0) {
last_visit <- rep(n_visits, N_i)
for (v in 2:n_visits) {
drops <- which(last_visit >= v & runif(N_i) < d_per_visit)
last_visit[drops] <- v - 1
}
dat <- dat[dat$visit <= last_visit[dat$id], ]
}
dat$age_c <- dat$age - knot
# -- Generate exposure X (mean 0, variance 1, within-person ICC) --
tau2  <- ICC_X
sig2x <- 1 - tau2
bx    <- rnorm(N_i, 0, sqrt(tau2))       # random intercept for X
dat$X <- bx[dat$id] + rnorm(nrow(dat), 0, sqrt(sig2x))
# -- Lagged predictor (Aim 3) --
if (use_lag) {
dat <- dat[order(dat$id, dat$visit), ]
dat$X_lag <- ave(dat$X, dat$id, FUN = function(x) c(NA, head(x, -1)))
dat <- dat[!is.na(dat$X_lag), ]
dat$X <- dat$X_lag
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
dat$visit_eff <- ave(dat$visit, dat$id, FUN = seq_along)
# -- Fit model --
fit <- tryCatch(
gls(Y ~ age_c + X, data = dat,
correlation = corSymm(form = ~ visit_eff | id),
weights = varIdent(form = ~ 1 | visit_eff)),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$tTable
p_gamma <- coefs["X", "p-value"]
convg <- I(all(eigen(fit$apVar)$values>0))
}else{
# -- Generate outcome --
re <- mvrnorm(N_i, mu = c(0, 0), Sigma = Sigma_re)
dat$b0 <- re[dat$id, 1]
dat$b1 <- re[dat$id, 2]
dat$mu <- (beta_0 + dat$b0) +
(beta_1 + dat$b1) * dat$age_c +
gamma_2 * dat$X
dat$Y  <- dat$mu + rnorm(nrow(dat), 0, sqrt(sigma2_e))
# -- Fit model --
fit <- tryCatch(
lmer(Y ~ age_c + X + (age_c | id), data = dat,
control = lmerControl(optimizer = "bobyqa",
check.conv.singular = "ignore",
optCtrl = list(maxfun = 1e5))),
error = function(e) NULL
)
if (is.null(fit)) return(NULL)
# -- Test: gamma_2 != 0 --
coefs <- summary(fit)$coefficients
p_gamma <- coefs["X", "Pr(>|t|)"]
convg <- !isSingular(fit)
}
c(p_gamma = p_gamma, converged = convg)
}
# ---- RUN SIMULATION ----
aim_label <- ifelse(use_lag, "Aim 3 (lagged predictor)", "Aim 2 (concurrent predictor)")
cat(sprintf("Running %d simulations for %s\n", n_sims, aim_label))
cat(sprintf("  Standardized effect size: %.2f\n", effect_size))
cat(sprintf("  gamma_2 = %.4f (raw scale)\n", gamma_2))
cat(sprintf("  N = %d, attrition = %.0f%%, age jitter SD = %.2f\n",
N, attrition * 100, age_sd))
if (use_lag) cat(sprintf("  Effective obs/child: %d (first visit dropped)\n", n_visits - 1))
results <- vector("list", n_sims)
pb <- txtProgressBar(min = 0, max = n_sims, style = 3)
set.seed(10983427)
for (i in seq_len(n_sims)) {
results[[i]] <- sim_one()
setTxtProgressBar(pb, i)
}
close(pb)
results <- do.call(rbind, results[!sapply(results, is.null)])
cat("\nSuccessful fits:", nrow(results), "out of", n_sims, "\n")
cat("Non-singular fits:", sum(results[, "converged"]), "\n")
# ---- POWER ESTIMATE ----
cat("\n===========================================================\n")
cat(sprintf("  POWER: %s (alpha = 0.05)\n", aim_label))
cat("===========================================================\n")
cat(sprintf("  Standardized effect size:  %.2f\n", effect_size))
cat(sprintf("  N = %d, %d sims\n", N, nrow(results)))
cat("-----------------------------------------------------------\n")
cat(sprintf("  gamma_2 != 0:  %.1f%%\n",
100 * mean(results[, "p_gamma"] < alpha)))
cat("===========================================================\n")
res <- rbind(res,
c(effect_size, use_lag, 100 * mean(results[, "p_gamma"]))
)
}
}
res <- data.frame(res)
names(res) <- c("effect_size", "use_lag", "power")
res
res <- data.frame(res)
names(res) <- c("effect_size", "use_lag", "power")
res$use_lag <- as.logical(res$use_lag)
res
res$power <- c(56.6,80.5,88.2,98.3,98.3,99.9)
res
citation("lme4")
# Chunk 1
#| echo: false
library(tidyverse)
library(this.path)
setwd(this.dir())
framingham <- read_csv("../../data/framingham.csv") |>
mutate(
male            = factor(male,            levels = c(0, 1),
labels = c("Female", "Male")),
currentSmoker   = factor(currentSmoker,   levels = c(0, 1),
labels = c("Non-smoker", "Smoker")),
BPMeds          = factor(BPMeds,          levels = c(0, 1),
labels = c("No", "Yes")),
prevalentStroke = factor(prevalentStroke, levels = c(0, 1),
labels = c("No", "Yes")),
prevalentHyp    = factor(prevalentHyp,    levels = c(0, 1),
labels = c("No", "Yes")),
diabetes        = factor(diabetes,        levels = c(0, 1),
labels = c("No", "Yes")),
TenYearCHD      = factor(TenYearCHD,      levels = c(0, 1),
labels = c("No", "Yes")),
education       = factor(education,       levels = 1:4,
labels = c("Some HS", "HS Diploma",
"Some College",
"College Degree"))
)
# Chunk 3
# Draw 1000 values from N(mean = 0.8, sd = 0.3) -- the crab weight example
set.seed(42)
crab_weights <- rnorm(n = 1000, mean = 0.8, sd = 0.3)
# What fraction weigh more than 1 kg?
mean(crab_weights > 1)
# The exact probability from the distribution
1 - pnorm(1, mean = 0.8, sd = 0.3)
# Chunk 4
# Visualize
tibble(weight = crab_weights) |>
ggplot(aes(x = weight)) +
geom_histogram(aes(y = after_stat(density)), binwidth = 0.05,
fill = "steelblue", color = "white") +
stat_function(fun = dnorm, args = list(mean = 0.8, sd = 0.3),
color = "firebrick", linewidth = 1) +
geom_vline(xintercept = 1, linetype = "dashed", color = "gray40") +
annotate("text", x = 1.05, y = 1.1, label = "1 kg threshold",
hjust = 0, color = "gray40", size = 3.5) +
labs(x = "Weight (kg)", y = "Density",
title = "Simulated Blue Crab Weights",
subtitle = "N(0.8, 0.3²) — red curve is the true density") +
theme_bw()
# Chunk 5
mu <- 0.8; sigma <- 0.3
# Probability within 1, 2, and 3 standard deviations
pnorm(mu + sigma, mu, sigma) - pnorm(mu - sigma, mu, sigma)
pnorm(mu + 2*sigma, mu, sigma) - pnorm(mu - 2*sigma, mu, sigma)
pnorm(mu + 3*sigma, mu, sigma) - pnorm(mu - 3*sigma, mu, sigma)
# Chunk 6
# 20 patients, each with 30% response probability
# How many respond?
set.seed(42)
rbinom(n = 1, size = 20, prob = 0.3)   # one experiment
rbinom(n = 10, size = 20, prob = 0.3)  # ten experiments
# Simulate 10,000 experiments and look at the distribution
sim_responses <- rbinom(n = 10000, size = 20, prob = 0.3)
tibble(responses = sim_responses) |>
ggplot(aes(x = responses)) +
geom_bar(fill = "steelblue") +
labs(x = "Number of responders (out of 20)",
y = "Count (out of 10,000 simulations)",
title = "Binomial(n = 20, p = 0.30)") +
theme_bw()
# Chunk 7
# Exact probability that exactly 8 out of 20 respond
dbinom(8, size = 20, prob = 0.3)
# Probability that 10 or more respond
1 - pbinom(9, size = 20, prob = 0.3)
# Chunk 8
# Mutations per kilobase, average rate lambda = 2
sim_mutations <- rpois(n = 10000, lambda = 2)
tibble(mutations = sim_mutations) |>
ggplot(aes(x = mutations)) +
geom_bar(fill = "steelblue") +
labs(x = "Mutations per kilobase",
y = "Count",
title = "Poisson(λ = 2)") +
theme_bw()
# Probability of 0 mutations in a kilobase
dpois(0, lambda = 2)
# Probability of 5 or more
1 - ppois(4, lambda = 2)
# Chunk 9
# Simulate from an exponential distribution -- strongly right-skewed
set.seed(123)
population <- rexp(100000, rate = 0.5)  # mean = 1/rate = 2
tibble(x = population) |>
ggplot(aes(x = x)) +
geom_histogram(binwidth = 0.3, fill = "steelblue", color = "white") +
labs(x = "Value", y = "Count",
title = "The population distribution (Exponential)",
subtitle = "Strongly right-skewed — far from Normal") +
theme_bw()
# Function: draw B samples of size n, compute their means
sample_means <- function(population, n, B = 5000) {
replicate(B, mean(sample(population, size = n)))
}
set.seed(123)
means_n5   <- sample_means(population, n = 5)
means_n30  <- sample_means(population, n = 30)
means_n100 <- sample_means(population, n = 100)
# Stack them for plotting
clt_data <- bind_rows(
tibble(xbar = means_n5,   n = "n = 5"),
tibble(xbar = means_n30,  n = "n = 30"),
tibble(xbar = means_n100, n = "n = 100")
) |>
mutate(n = factor(n, levels = c("n = 5", "n = 30", "n = 100")))
ggplot(clt_data, aes(x = xbar)) +
geom_histogram(aes(y = after_stat(density)), bins = 40,
fill = "steelblue", color = "white") +
facet_wrap(~ n, scales = "free") +
labs(x = "Sample mean", y = "Density",
title = "Sampling Distribution of the Mean",
subtitle = "Population is exponential (skewed). As n grows, the mean becomes Normal.") +
theme_bw()
