color = "Criterion") +
theme_minimal()
# Chunk 7
model_full <- lm(Y ~ age + weight + runtime + restpulse + runpulse + maxpulse,
data = FITNESS)
summary(model_full)
# Chunk 8
model_step_both <- step(model_full, direction = "both", trace = 1)
# Chunk 9
summary(model_step_both)
# Chunk 10
# Forward: start from intercept only
model_null <- lm(Y ~ 1, data = FITNESS)
model_step_fwd <- step(model_null,
scope = list(lower = model_null, upper = model_full),
direction = "forward", trace = 0)
# Backward: start from full model
model_step_bwd <- step(model_full, direction = "backward", trace = 0)
# Compare
tibble(
direction = c("Forward", "Backward", "Both"),
formula   = c(deparse(formula(model_step_fwd)),
deparse(formula(model_step_bwd)),
deparse(formula(model_step_both))),
AIC       = c(AIC(model_step_fwd), AIC(model_step_bwd), AIC(model_step_both)),
R_squared = c(summary(model_step_fwd)$r.squared,
summary(model_step_bwd)$r.squared,
summary(model_step_both)$r.squared)
)
# Chunk 11
# Does the full model improve significantly over the stepwise model?
anova(model_step_both, model_full)
# Chunk 12
set.seed(42)   # for reproducibility
# Assign each observation to a fold
n <- nrow(framingham)
K <- 5
framingham$fold <- sample(rep(1:K, length.out = n))
table(framingham$fold)
# Chunk 13
cv_mse <- function(formula, data, K = 5) {
mse_per_fold <- numeric(K)
for (k in 1:K) {
train <- data[data$fold != k, ]
test  <- data[data$fold == k, ]
model <- lm(formula, data = train)
preds <- predict(model, newdata = test)
mse_per_fold[k] <- mean((test$sysBP - preds)^2)
}
mean(mse_per_fold)
}
cv_results <- tibble(
model       = c("age only",
"age + BMI",
"age + BMI + totChol",
"age + BMI + totChol + cigsPerDay",
"age + BMI + totChol + cigsPerDay + glucose",
"age + BMI + totChol + cigsPerDay + glucose + diabetes"),
predictors  = 1:6,
cv_mse      = c(
cv_mse(sysBP ~ age, framingham),
cv_mse(sysBP ~ age + BMI, framingham),
cv_mse(sysBP ~ age + BMI + totChol, framingham),
cv_mse(sysBP ~ age + BMI + totChol + cigsPerDay, framingham),
cv_mse(sysBP ~ age + BMI + totChol + cigsPerDay + glucose, framingham),
cv_mse(sysBP ~ age + BMI + totChol + cigsPerDay + glucose + diabetes, framingham)
)
)
cv_results
#| fig-width: 7
#| fig-height: 4
ggplot(cv_results, aes(x = predictors, y = cv_mse)) +
geom_line(color = "steelblue", linewidth = 1) +
geom_point(color = "steelblue", size = 3) +
geom_point(data = filter(cv_results, cv_mse == min(cv_mse)),
color = "firebrick", size = 4) +
scale_x_continuous(breaks = 1:6) +
labs(x = "Number of predictors", y = "5-Fold CV Mean Squared Error",
title = "Cross-Validation Error Across Nested Models",
subtitle = "Red point marks the model with lowest CV error") +
theme_minimal()
cv_results$AIC <- c(AIC(m1), AIC(m2), AIC(m3), AIC(m4), AIC(m5), AIC(m6))
cv_results |>
select(model, predictors, cv_mse, AIC) |>
mutate(
best_cv  = if_else(cv_mse == min(cv_mse), "<-- best CV", ""),
best_aic = if_else(AIC == min(AIC), "<-- best AIC", "")
)
library(rsample)
set.seed(42)
folds <- vfold_cv(framingham, v = 5)
folds
cv_rsample <- function(formula, folds) {
mse_vals <- map_dbl(folds$splits, function(split) {
train <- analysis(split)
test  <- assessment(split)
model <- lm(formula, data = train)
preds <- predict(model, newdata = test)
mean((test$sysBP - preds)^2)
})
tibble(
mean_mse = mean(mse_vals),
sd_mse   = sd(mse_vals)
)
}
cv_rsample(sysBP ~ age + BMI + diaBP, folds)
cv_rsample(sysBP ~ age + BMI + totChol, folds)
full <- lm(sysBP ~ age + BMI + totChol + cigsPerDay + glucose + diabetes,
data = framingham)
summary(full)
selected <- step(full, direction = "both", trace = 0)
summary(selected)
AIC(full, selected)
anova(selected, full)
set.seed(42)
folds <- vfold_cv(framingham, v = 5)
cv_full     <- cv_rsample(sysBP ~ age + BMI + totChol + cigsPerDay + glucose + diabetes, folds)
cv_selected <- cv_rsample(formula(selected), folds)
bind_rows(
cv_full     |> mutate(model = "Full"),
cv_selected |> mutate(model = "Stepwise-selected")
) |>
select(model, mean_mse, sd_mse)
#| fig-width: 8
#| fig-height: 7
par(mfrow = c(2, 2))
plot(selected)
par(mfrow = c(1, 1))
