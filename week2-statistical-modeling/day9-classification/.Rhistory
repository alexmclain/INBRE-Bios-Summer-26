) +
theme_minimal()
# Optional: full power curves (using old code)
# effect_seq <- seq(0.5,0.8,0.02)
# curve_4 <- power_grid(alpha = alpha_4_tests, nsim = 2000, effects = effect_seq)
# curve_2 <- power_grid(alpha = alpha_2_tests, nsim = 2000, effects = effect_seq)
# curve_1 <- power_grid(alpha = 0.05, nsim = 2000, effects = effect_seq)
#
power_curve = tibble(
power = c(curve_4$power, curve_2$power, curve_1$power),
effect.size = rep(effect_seq, 3),
multiple.corr = as.factor(rep(c(4,2,1), each = length(effect_seq)))
)
ggplot(power_curve, aes(x = effect.size, y = power, group = multiple.corr)) +
geom_line(linewidth = 1, aes(color = multiple.corr)) +
geom_hline(yintercept = 0.80, linetype = "dashed") +
labs(
x = "Effect size (post group x time)",
y = "Power",
color = "Number of \ncorrections"
) +
theme_minimal()
saveRDS(power_curve, "Power_curve_ICC_0.1.rds")
power_curve %>% filter(power > 0.8)
power_curve %>% filter(power > 0.8) %>% View()
library(lme4)
library(lmerTest)
library(dplyr)
library(purrr)
library(tibble)
library(ggplot2)
library(tidyr)
# Alpha values
alpha_vec <- c(0.05, 0.05 / 2, 0.05 / 4)
# -----------------------------
# 1) Data generator
# -----------------------------
simulate_trial <- function(
n_trt = 150,
n_ctrl = 100,
retain = 0.80,
effect_post = 0.35,
effect_followup = 0.25,
ICC = 0.10,
sd_resid = 1.00,
mean_post = 0.10,
mean_followup = 0.15
) {
n <- n_trt + n_ctrl
sd_subject <- sqrt(ICC / (1 - ICC))
id <- seq_len(n)
arm <- factor(c(rep("control", n_ctrl), rep("treat", n_trt)),
levels = c("control", "treat"))
u <- rnorm(n, 0, sd_subject)
dat <- tidyr::expand_grid(
id = id,
time = factor(c("baseline", "post", "followup"),
levels = c("baseline", "post", "followup"))
) %>%
mutate(
arm = arm[id],
u = u[id],
common_time = case_when(
time == "baseline" ~ 0,
time == "post" ~ mean_post,
time == "followup" ~ mean_followup
),
trt_effect = case_when(
time == "baseline" ~ 0,
time == "post" ~ ifelse(arm == "treat", effect_post, 0),
time == "followup" ~ ifelse(arm == "treat", effect_followup, 0)
),
y = common_time + trt_effect + u + rnorm(n(), 0, sd_resid)
)
# Monotone attrition
drop_ids <- sample(id, size = round((1 - retain) * n))
dat <- dat %>%
filter(!(id %in% drop_ids & time != "baseline"))
dat
}
# -----------------------------
# 2) Fit model and extract p-values
# -----------------------------
fit_lmm <- function(dat) {
fit <- suppressWarnings(
lmer(y ~ arm * time + (1 | id), data = dat, REML = FALSE)
)
coefs <- coef(summary(fit))
p_post <- coefs["armtreat:timepost", "Pr(>|t|)"]
p_fu   <- coefs["armtreat:timefollowup", "Pr(>|t|)"]
list(
fit = fit,
p_post = p_post,
p_followup = p_fu
)
}
# -----------------------------
# 3) Power for one effect size, multiple alphas
# -----------------------------
estimate_power <- function(
effect_post = 0.35,
effect_followup = 0.25,
alpha = c(0.05, 0.05 / 2, 0.05 / 4),
nsim = 1000,
seed = 123
) {
set.seed(seed)
pvals <- replicate(nsim, {
dat <- simulate_trial(
effect_post = effect_post,
effect_followup = effect_followup
)
fit_lmm(dat)$p_post
})
out <- sapply(alpha, function(a) mean(pvals < a, na.rm = TRUE))
tibble(
alpha = alpha,
power = as.numeric(out)
)
}
# -----------------------------
# 4) Power across a grid of effect sizes
# -----------------------------
power_grid <- function(
effects = seq(0.20, 0.50, by = 0.05),
alpha = c(0.05, 0.05 / 2, 0.05 / 4),
nsim = 1000,
seed = 123
) {
map_dfr(effects, function(eff) {
estimate_power(
effect_post = eff,
effect_followup = eff * 0.75,
alpha = alpha,
nsim = nsim,
seed = seed
) %>%
mutate(effect.size = eff)
}) %>%
select(effect.size, alpha, power)
}
# -----------------------------
# 5) Minimal detectable effect size (MDE)
# -----------------------------
find_mde <- function(
alpha = c(0.05, 0.05 / 2, 0.05 / 4),
target_power = 0.80,
effects = seq(0.10, 0.80, by = 0.02),
nsim = 1000,
seed = 123
) {
pg <- power_grid(
effects = effects,
alpha = alpha,
nsim = nsim,
seed = seed
)
pg %>%
group_by(alpha) %>%
summarise(
mde = {
idx <- which(power >= target_power)[1]
if (is.na(idx)) NA_real_ else effect.size[idx]
},
.groups = "drop"
)
}
# -----------------------------
# 6) Example power values at d = 0.30, 0.40, 0.50
# -----------------------------
set.seed(1)
effects_to_check <- c(0.30, 0.40, 0.50)
effects_to_check <- c(0.65, 0.60, 0.53)
# -----------------------------
# 6) Example power values at d = 0.30, 0.40, 0.50
# -----------------------------
set.seed(1)
effects_to_check <- c(0.65, 0.60, 0.53)
power_table <- map_dfr(effects_to_check, function(eff) {
estimate_power(
effect_post = eff,
effect_followup = eff * 0.75,
alpha = alpha_vec,
nsim = 1000,
seed = 123
) %>%
mutate(effect.size = eff)
}) %>%
mutate(alpha_label = case_when(
alpha == 0.05 ~ "0.05",
alpha == 0.05 / 2 ~ "0.05/2",
alpha == 0.05 / 4 ~ "0.05/4",
TRUE ~ as.character(alpha)
)) %>%
select(effect.size, alpha_label, power)
power_table
write.csv(power_table, "detectable_ef_ICC_0.1.csv")
power_curve %>%
filter(power > 0.8) %>%
group_by(multiple.corr) %>%
slice_min(effect.size, n = 1) %>%
ungroup()
args(estimate_power)
