# Chunk 1
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung) |>
mutate(
sex_label  = factor(sex,      levels = c(1, 2),
labels = c("Male", "Female")),
ecog_group = factor(ph.ecog,  levels = c(0, 1, 2, 3),
labels = c("0 (fully active)",
"1 (ambulatory)",
"2 (in bed <50%)",
"3 (in bed >50%)"))
)
# Chunk 2
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
lung <- lung |>
filter(!is.na(ecog_group)) |>
mutate(
ecog_group2 = fct_collapse(ecog_group,
"0 (fully active)" = "0 (fully active)",
"1 (ambulatory)" = "1 (ambulatory)",
"2+ (non-ambulatory)" = c("2 (in bed <50%)",
"3 (in bed >50%)"))
)
lung |>
count(ecog_group2, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
lung <- lung |>
filter(!is.na(ecog_group)) |>
mutate(
ecog_group = fct_collapse(ecog_group,
"0 (fully active)" = "0 (fully active)",
"1 (ambulatory)" = "1 (ambulatory)",
"2+ (non-ambulatory)" = c("2 (in bed <50%)",
"3 (in bed >50%)"))
)
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
km_ecog <- survfit(Surv(time, status == 2) ~ ecog_group, data = lung)
print(km_ecog)
#| fig-width: 8
#| fig-height: 5
plot(km_ecog,
xlab      = "Time (days)",
ylab      = "Survival probability",
main      = "Kaplan-Meier Curves by ECOG Performance Score",
col       = c("steelblue", "darkgreen", "firebrick", "purple"),
lwd       = 2,
conf.int  = FALSE,
mark.time = TRUE)
legend("topright",
legend = c("0 (fully active)", "1 (ambulatory)",
"2 (in bed <50%)",  "3 (in bed >50%)"),
col    = c("steelblue", "darkgreen", "firebrick", "purple"),
lwd    = 2,
cex    = 0.85)
abline(h = 0.5, lty = 2, col = "gray50")
#| fig-width: 8
#| fig-height: 5
plot(km_ecog,
xlab      = "Time (days)",
ylab      = "Survival probability",
main      = "Kaplan-Meier Curves by ECOG Performance Score",
col       = c("steelblue", "darkgreen", "firebrick"),
lwd       = 2,
conf.int  = FALSE,
mark.time = TRUE)
legend("topright",
legend = c("0 (fully active)", "1 (ambulatory)",
"2+ (non-ambulatory)"),
col    = c("steelblue", "darkgreen", "firebrick"),
lwd    = 2,
cex    = 0.85)
abline(h = 0.5, lty = 2, col = "gray50")
survdiff(Surv(time, status == 2) ~ ecog_group, data = lung)
?lung
table(lung$pat.karno)
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung) |>
mutate(
sex_label  = factor(sex,      levels = c(1, 2),
labels = c("Male", "Female")),
pat.karno.gr  = factor(
ifelse(pat.karno > 80, "good", "poor")),
ecog_group = factor(ph.ecog,  levels = c(0, 1, 2, 3),
labels = c("0 (fully active)",
"1 (ambulatory)",
"2 (in bed <50%)",
"3 (in bed >50%)"))
)
str(lung)
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
