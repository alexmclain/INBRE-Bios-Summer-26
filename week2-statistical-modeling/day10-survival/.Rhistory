# Chunk 1
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung) |>
mutate(
sex_label  = factor(sex,      levels = c(1, 2),
labels = c("Male", "Female")),
ecog_group = factor(ph.ecog,  levels = c(0, 1, 2, 3),
labels = c("0 (fully active)",
"1 (ambulatory)",
"2 (in bed <50%)",
"3 (in bed >50%)"))
)
# Chunk 2
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
lung <- lung |>
filter(!is.na(ecog_group)) |>
mutate(
ecog_group2 = fct_collapse(ecog_group,
"0 (fully active)" = "0 (fully active)",
"1 (ambulatory)" = "1 (ambulatory)",
"2+ (non-ambulatory)" = c("2 (in bed <50%)",
"3 (in bed >50%)"))
)
lung |>
count(ecog_group2, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
lung <- lung |>
filter(!is.na(ecog_group)) |>
mutate(
ecog_group = fct_collapse(ecog_group,
"0 (fully active)" = "0 (fully active)",
"1 (ambulatory)" = "1 (ambulatory)",
"2+ (non-ambulatory)" = c("2 (in bed <50%)",
"3 (in bed >50%)"))
)
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
km_ecog <- survfit(Surv(time, status == 2) ~ ecog_group, data = lung)
print(km_ecog)
#| fig-width: 8
#| fig-height: 5
plot(km_ecog,
xlab      = "Time (days)",
ylab      = "Survival probability",
main      = "Kaplan-Meier Curves by ECOG Performance Score",
col       = c("steelblue", "darkgreen", "firebrick", "purple"),
lwd       = 2,
conf.int  = FALSE,
mark.time = TRUE)
legend("topright",
legend = c("0 (fully active)", "1 (ambulatory)",
"2 (in bed <50%)",  "3 (in bed >50%)"),
col    = c("steelblue", "darkgreen", "firebrick", "purple"),
lwd    = 2,
cex    = 0.85)
abline(h = 0.5, lty = 2, col = "gray50")
#| fig-width: 8
#| fig-height: 5
plot(km_ecog,
xlab      = "Time (days)",
ylab      = "Survival probability",
main      = "Kaplan-Meier Curves by ECOG Performance Score",
col       = c("steelblue", "darkgreen", "firebrick"),
lwd       = 2,
conf.int  = FALSE,
mark.time = TRUE)
legend("topright",
legend = c("0 (fully active)", "1 (ambulatory)",
"2+ (non-ambulatory)"),
col    = c("steelblue", "darkgreen", "firebrick"),
lwd    = 2,
cex    = 0.85)
abline(h = 0.5, lty = 2, col = "gray50")
survdiff(Surv(time, status == 2) ~ ecog_group, data = lung)
?lung
table(lung$pat.karno)
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung) |>
mutate(
sex_label  = factor(sex,      levels = c(1, 2),
labels = c("Male", "Female")),
pat.karno.gr  = factor(
ifelse(pat.karno > 80, "good", "poor")),
ecog_group = factor(ph.ecog,  levels = c(0, 1, 2, 3),
labels = c("0 (fully active)",
"1 (ambulatory)",
"2 (in bed <50%)",
"3 (in bed >50%)"))
)
str(lung)
lung |>
count(ecog_group, status) |>
mutate(status_label = if_else(status == 2, "Dead", "Censored")) |>
select(-status) |>
pivot_wider(names_from = status_label, values_from = n, values_fill = 0)
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung)
glimpse(lung)
# Chunk 1
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
# Chunk 2
data(lung)
lung <- as_tibble(lung)
glimpse(lung)
# Chunk 3
lung |>
count(status) |>
mutate(
label   = c("Censored", "Dead"),
percent = round(n / sum(n) * 100, 1)
)
# Chunk 4
# Naive approach 1: drop censored patients entirely
lung |>
filter(status == 2) |>
summarize(mean_time = mean(time), median_time = median(time))
# Naive approach 2: treat censoring time as the event time
lung |>
summarize(mean_time = mean(time), median_time = median(time))
# Chunk 5
# status == 2 means "dead" (event occurred)
# status == 1 means "censored" (event not observed)
lung <- lung |>
mutate(
surv_obj = Surv(time, status == 2),
sex_label = factor(sex, levels = c(1, 2), labels = c("Male", "Female"))
)
# Print a few values to see what a Surv object looks like
head(lung$surv_obj, 10)
# Chunk 6
#| fig-width: 7
#| fig-height: 4
lung |>
mutate(status_label = if_else(status == 2, "Event (dead)", "Censored")) |>
ggplot(aes(x = time, fill = status_label)) +
geom_histogram(binwidth = 60, color = "white", alpha = 0.8) +
scale_fill_manual(values = c("Event (dead)" = "firebrick",
"Censored"     = "steelblue")) +
labs(x = "Time (days)", y = "Count", fill = NULL,
title = "Distribution of Follow-up Times",
subtitle = "Red bars = patients who died; blue bars = censored") +
theme_minimal() +
theme(legend.position = "bottom")
km_overall <- survfit(Surv(time, status == 2) ~ 1, data = lung)
print(km_overall)
#| fig-width: 7
#| fig-height: 5
plot(km_overall,
xlab     = "Time (days)",
ylab     = "Survival probability",
main     = "Kaplan-Meier Curve: Lung Cancer Cohort",
col      = "steelblue",
lwd      = 2,
conf.int = TRUE,
mark.time = TRUE)
abline(h = 0.5, lty = 2, col = "gray50")
km_sex <- survfit(Surv(time, status == 2) ~ sex_label, data = lung)
print(km_sex)
#| fig-width: 7
#| fig-height: 5
plot(km_sex,
xlab      = "Time (days)",
ylab      = "Survival probability",
main      = "Kaplan-Meier Curves by Sex",
col       = c("steelblue", "firebrick"),
lwd       = 2,
conf.int  = FALSE,
mark.time = TRUE)
legend("topright",
legend = c("Male", "Female"),
col    = c("steelblue", "firebrick"),
lwd    = 2)
abline(h = 0.5, lty = 2, col = "gray50")
km_sex
survdiff(Surv(time, status == 2) ~ sex_label, data = lung)
# Restrict to complete cases on the variables we will use
vars_cox <- c("time", "status", "sex_label", "age", "ph.ecog")
lung_cc <- lung |>
drop_na(all_of(vars_cox))
nrow(lung) - nrow(lung_cc)
cox_full <- coxph(Surv(time, status == 2) ~ sex_label + age + ph.ecog,
data = lung_cc)
summary(cox_full)
cox_full_factor <- coxph(Surv(time, status == 2) ~ sex_label + age + factor(ph.ecog),
data = lung_cc)
summary(cox_full_factor)
anova(cox_full, cox_full_factor)
library(tidyverse)
library(this.path)
library(survival)
setwd(this.dir())
data(lung)
lung <- as_tibble(lung) |>
mutate(
sex_label  = factor(sex,      levels = c(1, 2),
labels = c("Male", "Female")),
pat.karno.gr  = factor(
ifelse(pat.karno > 80, "good", "poor")),
ecog_group = factor(ph.ecog,  levels = c(0, 1, 2, 3),
labels = c("0 (fully active)",
"1 (ambulatory)",
"2 (in bed <50%)",
"3 (in bed >50%)"))
)
