text(
one$CHpS,
one$Temp,
labels = one$ID,
pos = 3,
cex = 0.8
)
abline(model_temp, col = "red", lwd = 2)
model_temp <- lm(Temp ~ CHpS, data = one)
summary(model_temp)
anova(model_temp)
confint(model_temp)
predicted <- predict(model_temp)
residuals <- resid(model_temp)
# Combine results into a table
results <- data.frame(
Obs = one$ID,
Temp = one$Temp,
Predicted = predicted,
Residual = residuals
)
print(results)
plot(
one$CHpS,
one$Temp,
xlab = "CHpS",
ylab = "Temperature",
main = "Scatterplot of Temp vs CHpS",
pch = 19,
col = "blue"
)
# Add observation labels
text(
one$CHpS,
one$Temp,
labels = one$ID,
pos = 3,
cex = 0.8
)
abline(model_temp, col = "red", lwd = 2)
# Create new predictor values
new_data <- data.frame(
CHpS = c(16.5, 23.5)
)
# Confidence intervals for mean response
mean_ci <- predict(
model_temp,
newdata = new_data,
interval = "confidence"
)
# Prediction intervals for individual response
pred_pi <- predict(
model_temp,
newdata = new_data,
interval = "prediction"
)
# Combine prediction results
prediction_results <- data.frame(
CHpS = new_data$CHpS,
Predicted = mean_ci[, "fit"],
CI_Lower = mean_ci[, "lwr"],
CI_Upper = mean_ci[, "upr"],
PI_Lower = pred_pi[, "lwr"],
PI_Upper = pred_pi[, "upr"]
)
cat("\nPredictions with Confidence and Prediction Intervals:\n")
print(prediction_results)
