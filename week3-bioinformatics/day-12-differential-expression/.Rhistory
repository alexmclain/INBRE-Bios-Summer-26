rownames_to_column("gene_id") |>
as_tibble() |>
arrange(padj)
mean_expr <- rowMeans(counts(deseq_dds, normalized = TRUE))
disp_vals <- dispersions(deseq_dds)
# I'm going to add these to the results:
res_df <- res_df |>
mutate(disp_val = disp_vals)
res_df
hi_mean_gene
head(mean_expr)
