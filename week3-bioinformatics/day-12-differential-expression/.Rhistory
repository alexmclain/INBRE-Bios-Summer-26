library(tidyverse)
library(this.path)
library(SummarizedExperiment)
library(DESeq2)
library(pasilla)
library(pheatmap)
library(patchwork)
setwd(this.dir())
select <- dplyr::select
filter <- dplyr::filter
count <- dplyr::count
# ── Data loading (same as instructor demo) ─────────────────────────────────
counts_file <- system.file("extdata", "pasilla_gene_counts.tsv",
package = "pasilla")
meta_file   <- system.file("extdata", "pasilla_sample_annotation.csv",
package = "pasilla")
counts <- read.table(counts_file, header = TRUE, row.names = 1) |>
as.matrix()
meta <- read.csv(meta_file, row.names = 1)
rownames(meta) <- sub("fb", "", rownames(meta))
meta <- meta[colnames(counts), ]
# ── DESeq2 model (same as instructor demo) ─────────────────────────────────
dds <- DESeqDataSetFromMatrix(
countData = counts,
colData   = meta,
design    = ~ type + condition
)
dds$condition <- relevel(dds$condition, ref = "untreated")
dds$type      <- relevel(dds$type,      ref = "single-read")
keep          <- rowSums(counts(dds)) >= 10
dds           <- dds[keep, ]
deseq_dds     <- DESeq(dds)
res           <- results(deseq_dds, name = "condition_treated_vs_untreated")
# ── Results tibble used throughout ────────────────────────────────────────
res_df <- as.data.frame(res) |>
rownames_to_column("gene_id") |>
as_tibble() |>
arrange(padj)
# Chunk 2
cat("Rows:", nrow(res_df), "\n")
head(res_df)
# Chunk 3
cat("padj < 0.05:", res_df |> filter(padj < 0.05) |> nrow(), "\n")
cat("padj < 0.01:", res_df |> filter(padj < 0.01) |> nrow(), "\n")
res_df |>
filter(padj < 0.05) |>
mutate(direction = if_else(log2FoldChange > 0,
"Upregulated",
"Downregulated")) |>
count(direction)
res_df |>
slice_min(padj, n = 1) |>
select(gene_id, log2FoldChange, padj)
res_df |>
slice_min(padj, n = 10) |>
select(gene_id, log2FoldChange, padj) |>
mutate(log2FoldChange = round(log2FoldChange, 3),
padj           = formatC(padj, format = "e", digits = 2))
sf <- sizeFactors(deseq_dds)
sort(sf)
cat("Sample with largest size factor: ", names(which.max(sf)), round(max(sf), 3), "\n")
cat("Sample with smallest size factor:", names(which.min(sf)), round(min(sf), 3), "\n")
#| fig-width: 6
#| fig-height: 5
plotDispEsts(deseq_dds,
main = "Dispersion Estimates: pasilla",
cex  = 0.4)
mean_expr <- rowMeans(counts(deseq_dds, normalized = TRUE))
disp_vals <- dispersions(deseq_dds)
# Gene with highest mean expression
hi_mean_gene  <- names(which.max(mean_expr))
# Gene with lowest non-zero mean expression
lo_mean_gene  <- names(which.min(mean_expr[mean_expr > 0]))
# Most significant DE gene
top_de_gene   <- res_df$gene_id[1]
tibble(
Gene      = c(hi_mean_gene, lo_mean_gene, top_de_gene),
Category  = c("Highest mean", "Lowest non-zero mean", "Top DE gene"),
Mean_expr = round(mean_expr[c(hi_mean_gene, lo_mean_gene, top_de_gene)], 2),
Dispersion = round(disp_vals[c(hi_mean_gene, lo_mean_gene, top_de_gene)], 4)
)
disp_vals <- dispersions(deseq_dds)
head(disp_vals)
# Gene with highest mean expression
hi_mean_gene  <- names(which.max(mean_expr))
hi_mean_gene
# Gene with lowest non-zero mean expression
lo_mean_gene  <- names(which.min(mean_expr[mean_expr > 0]))
# Most significant DE gene
top_de_gene   <- res_df$gene_id[1]
str(disp_vals)
?dispersions
head(results(deseq_dds))
res_df
