# Chunk 1
library(tidyverse)
library(this.path)
library(SummarizedExperiment)
library(DESeq2)
library(airway)
library(patchwork)
setwd(this.dir())
data(airway)
# Chunk 2
counts <- assay(airway)
# Pull counts for one gene across all 8 samples
gene1 <- counts["ENSG00000103196", ]
gene1
# Chunk 3
#| fig-width: 8
#| fig-height: 4
p1 <- tibble(count = counts[, 1]) |>
filter(count > 0) |>
ggplot(aes(x = count)) +
geom_histogram(bins = 60, fill = "steelblue", color = "white") +
scale_x_log10(labels = scales::comma) +
labs(title = "Count distribution (log x-axis)",
x = "Count (log scale)", y = "Genes") +
theme_minimal()
# Mean-variance relationship across genes
gene_stats <- tibble(
mean_count = rowMeans(counts),
var_count  = apply(counts, 1, var)
) |>
filter(mean_count > 0, var_count > 0)
p2 <- gene_stats |>
slice_sample(n = 3000) |>
ggplot(aes(x = mean_count, y = var_count)) +
geom_point(alpha = 0.15, color = "steelblue") +
geom_abline(slope = 1, intercept = 0,
color = "firebrick", linetype = "dashed", linewidth = 1) +
scale_x_log10(labels = scales::comma) +
scale_y_log10(labels = scales::comma) +
labs(title = "Mean vs. variance (log-log scale)",
subtitle = "Red line = Poisson (variance = mean)",
x = "Mean count", y = "Variance") +
theme_minimal()
p1 + p2
# Chunk 4
sample_info <- as.data.frame(colData(airway))
sample_info |> select(SampleName, cell, dex)
# Chunk 5
identical(colnames(counts), rownames(sample_info))
# Chunk 6
dds <- DESeqDataSetFromMatrix(
countData = counts,
colData   = sample_info,
design    = ~ dex        # compare treated vs. untreated
)
dds
# Chunk 7
keep <- rowSums(counts(dds)) >= 10
dds  <- dds[keep, ]
cat("Genes before filtering:", nrow(counts), "\n")
cat("Genes after filtering: ", nrow(dds),    "\n")
cat("Genes removed:         ", nrow(counts) - nrow(dds), "\n")
# Chunk 8
dds$dex <- relevel(dds$dex, ref = "untrt")
levels(dds$dex)
# Chunk 9
deseq_dds <- DESeq(dds)
# Chunk 10
sizeFactors(deseq_dds)
# Chunk 11
#| fig-width: 6
#| fig-height: 5
plotDispEsts(deseq_dds,
main = "Dispersion Estimates",
cex  = 0.4)
# Chunk 12
res <- results(deseq_dds)
res
# Chunk 13
summary(res)
# Chunk 14
res_df <- as.data.frame(res) |>
rownames_to_column("gene_id") |>
as_tibble() |>
arrange(padj)
head(res_df)
gene_info <- as.data.frame(rowData(airway)) |>
rownames_to_column("gene_id") |>
select(gene_id, gene_name)
as.data.frame(rowData(airway)) |> View()
gene_info <- as.data.frame(rowData(airway)) |>
select(gene_id, gene_name)
gene_info
res_annotated <- res_df |>
left_join(gene_info, by = "gene_id") |>
select(gene_name, gene_id, baseMean, log2FoldChange, padj) |>
filter(!is.na(padj)) |>
arrange(padj)
head(res_annotated, 10)
# How many significant at padj < 0.05?
res_annotated |>
filter(padj < 0.05) |>
summarize(
n_sig        = n(),
n_up         = sum(log2FoldChange > 0),
n_down       = sum(log2FoldChange < 0)
)
# Top 5 upregulated and top 5 downregulated
res_annotated |>
filter(padj < 0.05) |>
slice_max(log2FoldChange,  n = 5) |>
bind_rows(
res_annotated |>
filter(padj < 0.05) |>
slice_min(log2FoldChange, n = 5)
) |>
select(gene_name, log2FoldChange, padj) |>
mutate(direction = if_else(log2FoldChange > 0, "Up", "Down"),
log2FoldChange = round(log2FoldChange, 2),
padj = formatC(padj, format = "e", digits = 2))
# Chunk 1
library(tidyverse)
library(this.path)
library(SummarizedExperiment)
library(DESeq2)
library(pasilla)
library(pheatmap)
setwd(this.dir())
# Chunk 2
counts_file <- system.file("extdata", "pasilla_gene_counts.tsv",
package = "pasilla")
meta_file   <- system.file("extdata", "pasilla_sample_annotation.csv",
package = "pasilla")
counts <- read.table(counts_file, header = TRUE, row.names = 1) |>
as.matrix()
meta <- read.csv(meta_file, row.names = 1)
rownames(meta) <- sub("fb", "", rownames(meta))
meta <- meta[colnames(counts), ]
identical(colnames(counts), rownames(meta))
# Reminder of the study design
meta |> select(condition, type)
names(meta)
meta
# Reminder of the study design
as.tibble(meta) |> select(condition, type)
# Reminder of the study design
as_tibble(meta) |> select(condition, type)
as_tibble(meta)
?select
# Reminder of the study design
as_tibble(meta) |> dplyr::select(condition, type)
dds <- DESeqDataSetFromMatrix(
countData = counts,
colData   = meta,
design    = ~ type + condition   # adjust for library type, test condition
)
# Set reference levels
dds$condition <- relevel(dds$condition, ref = "untreated")
dds$type      <- relevel(dds$type,      ref = "single-read")
# Filter low-count genes
keep <- rowSums(counts(dds)) >= 10
dds  <- dds[keep, ]
cat("Genes retained after filtering:", nrow(dds), "\n")
