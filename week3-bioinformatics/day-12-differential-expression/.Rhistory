res_df[res_df$gene_id %in% c(hi_mean_gene, lo_mean_gene, top_de_gene),]
summary(res_df)
ggplot(res_df, aes(x = baseMean, y = disp_val)) + geom_point()
ggplot(res_df |> filter(baseMean < 3), aes(x = baseMean, y = disp_val)) + geom_point()
# Creating a tibble with the results (IMPORTANT: do not sort by padj.)
