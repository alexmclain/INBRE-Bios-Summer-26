filter(!is.na(padj)) |>
slice_min(padj, n = 25) |>
pull(gene_id)
mat        <- assay(vsd)[top25_ids, ]
mat_scaled <- t(scale(t(mat)))
col_anno <- colData(vsd) |>
as_tibble(rownames = "sample") |>
select(sample, condition, type) |>
mutate(condition = as.character(condition),
type      = as.character(type)) |>
column_to_rownames("sample")
pheatmap(mat_scaled,
annotation_col  = col_anno,
cluster_rows    = TRUE,
cluster_cols    = TRUE,
show_rownames   = TRUE,
show_colnames   = FALSE,
color           = colorRampPalette(
c("steelblue", "white", "firebrick"))(100),
main            = "Top 25 DE Genes (VST, row-scaled)")
# Chunk 1
library(tidyverse)
library(this.path)
library(SummarizedExperiment)
library(DESeq2)
library(airway)
library(patchwork)
setwd(this.dir())
data(airway)
# Chunk 2
counts <- assay(airway)
# Pull counts for one gene across all 8 samples
gene1 <- counts["ENSG00000103196", ]
gene1
# Chunk 3
#| fig-width: 8
#| fig-height: 4
p1 <- tibble(count = counts[, 1]) |>
filter(count > 0) |>
ggplot(aes(x = count)) +
geom_histogram(bins = 60, fill = "steelblue", color = "white") +
scale_x_log10(labels = scales::comma) +
labs(title = "Count distribution (log x-axis)",
x = "Count (log scale)", y = "Genes") +
theme_minimal()
# Mean-variance relationship across genes
gene_stats <- tibble(
mean_count = rowMeans(counts),
var_count  = apply(counts, 1, var)
) |>
filter(mean_count > 0, var_count > 0)
p2 <- gene_stats |>
slice_sample(n = 3000) |> #Randomly sample 3000 rows (out of >33K)
ggplot(aes(x = mean_count, y = var_count)) +
geom_point(alpha = 0.15, color = "steelblue") +
geom_abline(slope = 1, intercept = 0,
color = "firebrick", linetype = "dashed", linewidth = 1) +
scale_x_log10(labels = scales::comma) +
scale_y_log10(labels = scales::comma) +
labs(title = "Mean vs. variance (log-log scale)",
subtitle = "Red line = Poisson (variance = mean)",
x = "Mean count", y = "Variance") +
theme_minimal()
p1 + p2
# Chunk 4
sample_info <- as.data.frame(colData(airway))
sample_info |> select(SampleName, cell, dex)
# Chunk 5
identical(colnames(counts), rownames(sample_info))
# Chunk 6
dds <- DESeqDataSetFromMatrix(
countData = counts,
colData   = sample_info,
design    = ~ dex        # compare treated vs. untreated
)
dds
# Chunk 7
keep <- rowSums(counts(dds)) >= 10
dds  <- dds[keep, ]
cat("Genes before filtering:", nrow(counts), "\n")
cat("Genes after filtering: ", nrow(dds),    "\n")
cat("Genes removed:         ", nrow(counts) - nrow(dds), "\n")
# Chunk 8
dds$dex <- relevel(dds$dex, ref = "untrt")
levels(dds$dex)
# Chunk 9
deseq_dds <- DESeq(dds)
# Chunk 10
sizeFactors(deseq_dds)
# Chunk 11
#| fig-width: 6
#| fig-height: 5
plotDispEsts(deseq_dds,
main = "Dispersion Estimates",
cex  = 0.4)
# Chunk 12
res <- results(deseq_dds)
res
# Chunk 13
summary(res)
head(res)
as.data.frame(res) |>
rownames_to_column("gene_id") |> head()
as.data.frame(res) |>
rownames_to_column("gene_id") |>
as_tibble()
res_df <- as_tibble(res)
head(res_df)
