nsim = 1000,
seed = 123
)
# Packages
library(lme4)
library(lmerTest)
library(dplyr)
library(purrr)
library(tibble)
library(ggplot2)
library(tidyr)
# Alpha values
alpha_vec <- c(0.05)
# -----------------------------
# 1) Data generator
# -----------------------------
# ICC parameterization holds total marginal variance constant at sd_total^2.
#   sd_subject = sqrt(ICC) * sd_total
#   sd_resid   = sqrt(1 - ICC) * sd_total
# Effect sizes (effect_post, effect_followup) are therefore in sd_total units
# (i.e., Cohen's d when sd_total = 1).
simulate_trial <- function(
n_trt = 99,
n_ctrl = 99,
retain = 0.80,
effect_post = 0.46,
effect_followup = 0.46,
ICC = 0.50,
sd_total = 1.00,
mean_post = 0.10,
mean_followup = 0.15,
coach_rho = 0.01,
coach_N = 10
) {
# Coach level design effect
n_trt_new <- n_trt
if(coach_rho > 0){
DE <- 1 + (n_trt/coach_N - 1)*coach_rho
n_trt_new <- ceiling(n_trt/DE)
}
n_trt <- n_trt_new
n <- n_trt + n_ctrl
sd_subject <- sqrt(ICC) * sd_total
sd_resid   <- sqrt(1 - ICC) * sd_total
id  <- seq_len(n)
arm <- factor(c(rep("control", n_ctrl), rep("treat", n_trt)),
levels = c("control", "treat"))
u <- rnorm(n, 0, sd_subject)
dat <- tidyr::expand_grid(
id = id,
time = factor(c("baseline", "post", "followup"),
levels = c("baseline", "post", "followup"))
) %>%
mutate(
arm = arm[id],
u = u[id],
common_time = case_when(
time == "baseline" ~ 0,
time == "post" ~ mean_post,
time == "followup" ~ mean_followup
),
trt_effect = case_when(
time == "baseline" ~ 0,
time == "post" ~ ifelse(arm == "treat", effect_post, 0),
time == "followup" ~ ifelse(arm == "treat", effect_followup, 0)
),
y = common_time + trt_effect + u + rnorm(n(), 0, sd_resid)
)
# Monotone attrition
drop_ids <- sample(id, size = round((1 - retain) * n))
dat <- dat %>%
filter(!(id %in% drop_ids & time != "baseline"))
dat
}
# -----------------------------
# 2) Fit model and extract p-values
# -----------------------------
fit_lmm <- function(dat) {
fit <- suppressWarnings(
lmer(y ~ arm * time + (1 | id), data = dat, REML = TRUE,
control = lmerControl(check.conv.singular = .makeCC("ignore", tol = 1e-4)))
)
coefs <- coef(summary(fit))
p_post <- coefs["armtreat:timepost", "Pr(>|t|)"]
p_fu   <- coefs["armtreat:timefollowup", "Pr(>|t|)"]
list(
fit = fit,
p_post = p_post,
p_followup = p_fu
)
}
fit_ancova <- function(dat) {
# Pivot to wide: one row per subject
wide <- dat %>%
select(id, arm, time, y) %>%
pivot_wider(names_from = time, values_from = y)
# ANCOVA: post ~ arm + baseline (complete cases only)
fit <- lm(post ~ arm + baseline, data = wide)
coefs <- coef(summary(fit))
p_post <- coefs["armtreat", "Pr(>|t|)"]
# Follow-up ANCOVA (optional)
fit_fu <- lm(followup ~ arm + baseline, data = wide)
coefs_fu <- coef(summary(fit_fu))
p_fu <- coefs_fu["armtreat", "Pr(>|t|)"]
list(fit = fit, p_post = p_post, p_followup = p_fu)
}
# -----------------------------
# 3) Power for one effect size, multiple alphas
# -----------------------------
estimate_power <- function(
effect_post = 0.46,
effect_followup = 0.46,
n_trt = 99,
n_ctrl = 99,
retain = 0.80,
ICC = 0.50,
sd_total = 1.00,
mean_post = 0.10,
mean_followup = 0.15,
alpha = c(0.05),
outcome = c("post", "followup"),
coach_rho = 0.01,
coach_N = 9,
nsim = 1000,
seed = 123
) {
outcome <- match.arg(outcome)
set.seed(seed)
pvals <- replicate(nsim, {
dat <- simulate_trial(
n_trt = n_trt,
n_ctrl = n_ctrl,
retain = retain,
effect_post = effect_post,
effect_followup = effect_followup,
ICC = ICC,
sd_total = sd_total,
mean_post = mean_post,
mean_followup = mean_followup,
coach_rho = coach_rho,
coach_N = coach_N
)
res <- fit_lmm(dat)
if (outcome == "post") res$p_post else res$p_followup
})
out <- sapply(alpha, function(a) mean(pvals < a, na.rm = TRUE))
tibble(
alpha = alpha,
power = as.numeric(out)
)
}
