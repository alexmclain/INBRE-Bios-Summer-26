labs(title = "PCA: Airway Dataset",
subtitle = "PC1 should separate treatment groups") +
theme_minimal()
pca_data <- plotPCA(vsd, intgroup = c("dex", "cell"), returnData = TRUE)
pct_var  <- round(100 * attr(pca_data, "percentVar"))
