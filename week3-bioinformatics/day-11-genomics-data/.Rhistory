outcome = c("post", "followup"),
nsim = 1000,
seed = 123
) {
outcome <- match.arg(outcome)
set.seed(seed)
pvals <- replicate(nsim, {
dat <- simulate_trial(
n_trt = n_trt,
n_ctrl = n_ctrl,
retain = retain,
effect_post = effect_post,
effect_followup = effect_followup,
ICC = ICC,
sd_total = sd_total,
mean_post = mean_post,
mean_followup = mean_followup
)
res <- fit_lmm(dat)
if (outcome == "post") res$p_post else res$p_followup
})
out <- sapply(alpha, function(a) mean(pvals < a, na.rm = TRUE))
tibble(
alpha = alpha,
power = as.numeric(out)
)
}
# -----------------------------
# 4) Power across a grid of effect sizes
# -----------------------------
# Extra simulate_trial parameters (n_trt, n_ctrl, retain, ICC, sd_total,
# mean_post, mean_followup, outcome) can be passed via ...
power_grid <- function(
effects = seq(0.20, 0.50, by = 0.05),
followup_ratio = 0.75,
alpha = c(0.05, 0.05 / 2, 0.05 / 4),
nsim = 1000,
seed = 123,
...
) {
map_dfr(effects, function(eff) {
estimate_power(
effect_post = eff,
effect_followup = eff * followup_ratio,
alpha = alpha,
nsim = nsim,
seed = seed,
...
) %>%
mutate(effect.size = eff)
}) %>%
select(effect.size, alpha, power)
}
# -----------------------------
# 5) Smallest N achieving target power at a given effect size
# -----------------------------
# ratios: list of integer pairs c(trt_parts, ctrl_parts), e.g. list(c(3,2), c(1,1))
# Iterates n_seq in order and stops at the first N that meets target_power.
# Extra simulate_trial parameters (retain, ICC, sd_total, etc.) can be passed via ...
find_n <- function(
effect_post     = 0.35,
effect_followup = effect_post * 0.75,
ratios          = list(c(3, 2), c(1, 1)),
n_seq           = seq(50, 600, by = 10),
target_power    = 0.80,
alpha           = 0.05,
outcome         = "post",
nsim            = 500,
seed            = 123,
...
) {
map_dfr(ratios, function(r) {
trt_frac    <- r[1] / sum(r)
ratio_label <- paste0(r[1], ":", r[2])
result <- NULL
for (n in n_seq) {
n_trt  <- round(n * trt_frac)
n_ctrl <- n - n_trt
pw <- estimate_power(
effect_post     = effect_post,
effect_followup = effect_followup,
n_trt           = n_trt,
n_ctrl          = n_ctrl,
alpha           = alpha,
outcome         = outcome,
nsim            = nsim,
seed            = seed,
...
)$power   # length-1 vector because alpha is scalar
if (pw >= target_power) {
result <- tibble(
ratio   = ratio_label,
n_total = n,
n_trt   = n_trt,
n_ctrl  = n_ctrl,
power   = pw
)
break
}
}
if (is.null(result))
tibble(ratio = ratio_label, n_total = NA_integer_,
n_trt = NA_integer_, n_ctrl = NA_integer_, power = NA_real_)
else
result
})
}
