library(tidyverse)
library(this.path)
library(SummarizedExperiment)
library(DESeq2)
library(airway)
library(factoextra)
library(cluster)
library(pheatmap)
setwd(this.dir())
data(airway)
counts      <- assay(airway)
sample_info <- as.data.frame(colData(airway))
dds <- DESeqDataSetFromMatrix(
countData = counts,
colData   = sample_info,
design    = ~ cell + dex
)
dds$dex  <- relevel(dds$dex,  ref = "untrt")
dds$cell <- relevel(dds$cell, ref = "N052611")
keep <- rowSums(counts(dds)) >= 10
dds  <- dds[keep, ]
deseq_dds <- DESeq(dds)
res        <- results(deseq_dds)
summary(res)
