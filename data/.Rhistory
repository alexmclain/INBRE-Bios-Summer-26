) {
n <- n_trt + n_ctrl
id <- seq_len(n)
arm <- factor(c(rep("control", n_ctrl), rep("treat", n_trt)),
levels = c("control", "treat"))
u <- rnorm(n, 0, sd_subject)
dat <- tidyr::expand_grid(
id = id,
time = factor(c("baseline", "post", "followup"),
levels = c("baseline", "post", "followup"))
) %>%
mutate(
arm = arm[id],
u = u[id],
common_time = case_when(
time == "baseline" ~ 0,
time == "post" ~ mean_post,
time == "followup" ~ mean_followup
),
trt_effect = case_when(
time == "baseline" ~ 0,
time == "post" ~ ifelse(arm == "treat", effect_post, 0),
time == "followup" ~ ifelse(arm == "treat", effect_followup, 0)
),
y = common_time + trt_effect + u + rnorm(n(), 0, sd_resid)
)
# Monotone attrition: 1 - retain of participants lose post/follow-up
drop_ids <- sample(id, size = round((1 - retain) * n))
dat <- dat %>%
filter(!(id %in% drop_ids & time != "baseline"))
dat
}
# Optional: full power curves
effect_seq <- seq(0.5,0.8,0.02)
curve_4 <- power_grid(alpha = alpha_4_tests, nsim = 1000, effects = effect_seq)
sqrt(1/9)
# -----------------------------
# 1) Data generator
# -----------------------------
simulate_trial <- function(
n_trt = 150,
n_ctrl = 100,
retain = 0.80,              # proportion retained at post/follow-up
effect_post = 0.35,         # standardized treatment effect at post
effect_followup = 0.25,     # standardized treatment effect at follow-up
ICC = 0.1,          # ICC: used to set the random effect sd
sd_resid = 1.00,            # residual SD
mean_post = 0.10,           # common time effect at post
mean_followup = 0.15        # common time effect at follow-up
) {
n <- n_trt + n_ctrl
sd_subject <- sqrt(ICC/(1-ICC))
id <- seq_len(n)
arm <- factor(c(rep("control", n_ctrl), rep("treat", n_trt)),
levels = c("control", "treat"))
u <- rnorm(n, 0, sd_subject)
dat <- tidyr::expand_grid(
id = id,
time = factor(c("baseline", "post", "followup"),
levels = c("baseline", "post", "followup"))
) %>%
mutate(
arm = arm[id],
u = u[id],
common_time = case_when(
time == "baseline" ~ 0,
time == "post" ~ mean_post,
time == "followup" ~ mean_followup
),
trt_effect = case_when(
time == "baseline" ~ 0,
time == "post" ~ ifelse(arm == "treat", effect_post, 0),
time == "followup" ~ ifelse(arm == "treat", effect_followup, 0)
),
y = common_time + trt_effect + u + rnorm(n(), 0, sd_resid)
)
# Monotone attrition: 1 - retain of participants lose post/follow-up
drop_ids <- sample(id, size = round((1 - retain) * n))
dat <- dat %>%
filter(!(id %in% drop_ids & time != "baseline"))
dat
}
# Optional: full power curves
